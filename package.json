{
  "name": "najaf-stays",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hotel planning for FH Mumbai groups in Najaf: pulls approved tours from NKERP and allocates them across Ruya, Araf and Hotel C.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs --dev",
    "build": "tsc --noEmit && vite build && node scripts/embed-assets.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "exceljs": "^4.4.0",
    "motion": "^14.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
